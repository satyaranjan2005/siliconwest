# ==========================================
# Silicon West - Production Environment Config
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=siliconwest_db
POSTGRES_PORT=5432

# Backend API Configuration
BACKEND_PORT=5000
JWT_SECRET=replace_with_a_long_random_jwt_secret_token

# Zoho Mail SMTP Credentials
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@siliconwest.in
SMTP_PASS=your_zoho_app_password
EMAIL_FROM=Silicon West Portal <noreply@siliconwest.in>

# Super Admin Account
SUPER_ADMIN_EMAIL=23bcsn72.cse@silicon.ac.in

# Frontend Public API URL (Accessible from user's browser)
# Example: http://your-server-ip:5000/api OR https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_PORT=3000


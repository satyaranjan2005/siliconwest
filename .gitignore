# ==========================================
# Root Gitignore for Silicon West Project
# ==========================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.*

# Environment & Secret Files (CRITICAL: Never commit .env files)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Next.js Build Outputs
.next/
frontend/.next/
out/
frontend/out/
build/
dist/

# Logs & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Deployment & Vercel
.vercel/

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
.turbo/
.cache/

# Runtime data & temp files
tmp/
temp/
pids/
*.pid
*.seed
*.pid.lock

# IDE & Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db


# Server Configuration
PORT=5000
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/siliconwest_db?schema=public"
JWT_SECRET="your-super-secret-jwt-key"

# ==========================================
# ZOHO MAIL SMTP CREDENTIALS
# ==========================================
# Outgoing Server:
# - For India accounts (.in): smtppro.zoho.in (organization domain) or smtp.zoho.in (personal)
# - For Global accounts (.com): smtppro.zoho.com (organization domain) or smtp.zoho.com (personal)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true

# Your full Zoho email address
SMTP_USER=your_zoho_email@yourdomain.com

# Zoho Application-Specific Password
SMTP_PASS=your-zoho-app-password

# Sender Address & Display Name
EMAIL_FROM="Silicon West Portal <your_zoho_email@yourdomain.com>"

# Super Admin Account Configuration
SUPER_ADMIN_EMAIL="admin@silicon.ac.in"
